{
  "name": "stockflow",
  "version": "1.0.0",
  "private": true,
  "description": "StockFlow - full-stack inventory management system",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w server && npm run build -w client",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client",
    "lint": "npm run lint -w server && npm run lint -w client",
    "test": "npm run test -w server",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server",
    "db:studio": "npm run db:studio -w server",
    "format": "prettier --write \"{server,client}/**/*.{ts,tsx,css,json,md}\"",
    "setup": "npm install && npm run db:up && npm run db:migrate && npm run db:seed"
  },
